# Sao chép thành .env (hoặc .env.local) rồi điền giá trị thật. Không commit file có khoá thật.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chỉ dùng ở server (quản lý thành viên, bài tập). Tuyệt đối không đưa lên client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Địa chỉ site ---
# Dùng cho SEO (metadataBase, sitemap, robots) và link mời thành viên.
NEXT_PUBLIC_SITE_URL=https://khanhhoiwebnew.vercel.app
# Trang nhận link đặt lại mật khẩu (thường giống NEXT_PUBLIC_SITE_URL).
PASSWORD_RESET_SITE_URL=https://khanhhoiwebnew.vercel.app

# --- Mạng xã hội ở footer (để trống thì ẩn biểu tượng) ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@httlkhanhhoi4369

# --- Bài giảng YouTube ---
YOUTUBE_CHANNEL_HANDLE=@httlkhanhhoi4369
# Không bắt buộc: điền sẵn để khỏi phải dò channel id từ handle.
YOUTUBE_CHANNEL_ID=
YOUTUBE_FEED_REVALIDATE_SECONDS=1800
